package sportsleague;

	import java.util.*;

	// ---------------------- Team Class ----------------------
	class Team {
	    private String name;
	    private List<Player> players;
	    private int points;
	    private int goalsFor;
	    private int goalsAgainst;
	    private List<DisciplinaryRecord> disciplinaryRecords;

	    public Team(String name) {
	        this.name = name;
	        this.players = new ArrayList<>();
	        this.points = 0;
	        this.goalsFor = 0;
	        this.goalsAgainst = 0;
	        this.disciplinaryRecords = new ArrayList<>();
	    }

	    public String getName() { return name; }
	    public List<Player> getPlayers() { return players; }
	    public int getPoints() { return points; }
	    public int getGoalsFor() { return goalsFor; }
	    public int getGoalsAgainst() { return goalsAgainst; }

	    public void addPlayer(Player p) {
	        players.add(p);
	    }

	    public void updateResult(int goalsScored, int goalsConceded) {
	        goalsFor += goalsScored;
	        goalsAgainst += goalsConceded;
	        if (goalsScored > goalsConceded) points += 3;
	        else if (goalsScored == goalsConceded) points += 1;
	    }

	    public void addDisciplinaryRecord(DisciplinaryRecord record) {
	        disciplinaryRecords.add(record);
	    }

	    public List<DisciplinaryRecord> getDisciplinaryRecords() {
	        return disciplinaryRecords;
	    }
	}

	// ---------------------- Player Class ----------------------
	class Player {
	    private String name;
	    private int age;
	    private Team team;

	    public Player(String name, int age, Team team) {
	        this.name = name;
	        this.age = age;
	        this.team = team;
	    }

	    public String getName() { return name; }
	    public Team getTeam() { return team; }
	}

	// ---------------------- Fixture Class ----------------------
	class Fixture {
	    private Team homeTeam;
	    private Team awayTeam;
	    private Date matchDate;
	    private Match match;

	    public Fixture(Team home, Team away, Date date) {
	        this.homeTeam = home;
	        this.awayTeam = away;
	        this.matchDate = date;
	        this.match = null;
	    }

	    public Team getHomeTeam() { return homeTeam; }
	    public Team getAwayTeam() { return awayTeam; }
	    public Date getMatchDate() { return matchDate; }
	    public void setMatch(Match match) { this.match = match; }
	    public Match getMatch() { return match; }

	    @Override
	    public String toString() {
	        return homeTeam.getName() + " vs " + awayTeam.getName() + " on " + matchDate;
	    }
	}

	// ---------------------- Match Class ----------------------
	class Match {
	    private Fixture fixture;
	    private Result result;

	    public Match(Fixture fixture) {
	        this.fixture = fixture;
	    }

	    public void setResult(Result result) {
	        this.result = result;
	        fixture.getHomeTeam().updateResult(result.getHomeScore(), result.getAwayScore());
	        fixture.getAwayTeam().updateResult(result.getAwayScore(), result.getHomeScore());
	    }

	    public Result getResult() { return result; }
	}

	// ---------------------- Result Class ----------------------
	class Result {
	    private int homeScore;
	    private int awayScore;

	    public Result(int homeScore, int awayScore) {
	        this.homeScore = homeScore;
	        this.awayScore = awayScore;
	    }

	    public int getHomeScore() { return homeScore; }
	    public int getAwayScore() { return awayScore; }
	}

	// ---------------------- DisciplinaryRecord Class ----------------------
	class DisciplinaryRecord {
	    private Player player;
	    private String action; // e.g., "Yellow Card", "Red Card"

	    public DisciplinaryRecord(Player player, String action) {
	        this.player = player;
	        this.action = action;
	    }

	    public Player getPlayer() { return player; }
	    public String getAction() { return action; }

	    @Override
	    public String toString() {
	        return player.getName() + " - " + action;
	    }
	}

	// ---------------------- Main Application ----------------------
	public class SportsLeague {
	    private static List<Team> teams = new ArrayList<>();
	    private static List<Fixture> fixtures = new ArrayList<>();
	    private static Scanner sc = new Scanner(System.in);

	    public static void main(String[] args) {
	        int choice;
	        do {
	            System.out.println("\n--- Sports League Menu ---");
	            System.out.println("1. Add Team");
	            System.out.println("2. Add Player");
	            System.out.println("3. Create Fixture");
	            System.out.println("4. Record Match Result");
	            System.out.println("5. View Standings");
	            System.out.println("6. View Disciplinary Log");
	            System.out.println("7. Exit");
	            System.out.print("Enter choice: ");
	            choice = sc.nextInt();
	            sc.nextLine(); // consume newline

	            switch(choice) {
	                case 1: addTeam(); break;
	                case 2: addPlayer(); break;
	                case 3: createFixture(); break;
	                case 4: recordMatch(); break;
	                case 5: viewStandings(); break;
	                case 6: viewDisciplinaryLog(); break;
	                case 7: System.out.println("Exiting..."); break;
	                default: System.out.println("Invalid choice.");
	            }
	        } while(choice != 7);
	    }

	    private static void addTeam() {
	        System.out.print("Enter team name: ");
	        String name = sc.nextLine();
	        teams.add(new Team(name));
	        System.out.println("Team added.");
	    }

	    private static void addPlayer() {
	        System.out.print("Enter player name: ");
	        String name = sc.nextLine();
	        System.out.print("Enter age: ");
	        int age = sc.nextInt();
	        sc.nextLine();
	        System.out.println("Select team:");
	        for (int i = 0; i < teams.size(); i++) {
	            System.out.println((i+1) + ". " + teams.get(i).getName());
	        }
	        int t = sc.nextInt() - 1;
	        sc.nextLine();
	        Player player = new Player(name, age, teams.get(t));
	        teams.get(t).addPlayer(player);
	        System.out.println("Player added.");
	    }

	    private static void createFixture() {
	        System.out.println("Select home team:");
	        for (int i = 0; i < teams.size(); i++) {
	            System.out.println((i+1) + ". " + teams.get(i).getName());
	        }
	        int home = sc.nextInt() - 1;
	        System.out.println("Select away team:");
	        for (int i = 0; i < teams.size(); i++) {
	            if (i != home)
	                System.out.println((i+1) + ". " + teams.get(i).getName());
	        }
	        int away = sc.nextInt() - 1;
	        sc.nextLine();
	        System.out.print("Enter match date (YYYY-MM-DD): ");
	        String dateStr = sc.nextLine();
	        Date date = java.sql.Date.valueOf(dateStr);
	        fixtures.add(new Fixture(teams.get(home), teams.get(away), date));
	        System.out.println("Fixture created.");
	    }

	    private static void recordMatch() {
	        if (fixtures.isEmpty()) { System.out.println("No fixtures."); return; }
	        System.out.println("Select fixture to record result:");
	        for (int i = 0; i < fixtures.size(); i++) {
	            System.out.println((i+1) + ". " + fixtures.get(i));
	        }
	        int f = sc.nextInt() - 1;
	        sc.nextLine();
	        Fixture fixture = fixtures.get(f);

	        System.out.print("Enter home team score: ");
	        int homeScore = sc.nextInt();
	        System.out.print("Enter away team score: ");
	        int awayScore = sc.nextInt();
	        sc.nextLine();

	        Result result = new Result(homeScore, awayScore);
	        Match match = new Match(fixture);
	        match.setResult(result);
	        fixture.setMatch(match);
	        System.out.println("Result recorded.");
	    }

	    private static void viewStandings() {
	        teams.sort((t1, t2) -> t2.getPoints() - t1.getPoints());
	        System.out.println("\n--- Standings ---");
	        System.out.printf("%-15s %-5s %-5s %-5s\n", "Team", "Pts", "GF", "GA");
	        for (Team t : teams) {
	            System.out.printf("%-15s %-5d %-5d %-5d\n",
	                t.getName(), t.getPoints(), t.getGoalsFor(), t.getGoalsAgainst());
	        }
	    }

	    private static void viewDisciplinaryLog() {
	        System.out.println("\n--- Disciplinary Logs ---");
	        for (Team t : teams) {
	            if (!t.getDisciplinaryRecords().isEmpty()) {
	                System.out.println("Team: " + t.getName());
	                for (DisciplinaryRecord d : t.getDisciplinaryRecords()) {
	                    System.out.println("  " + d);
	                }
	            }
	        }
	    }
	}


